<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MusicScope.Desktop.ViewModels"
        xmlns:ctrl="using:MusicScope.Desktop.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1180" d:DesignHeight="740"
        x:Class="MusicScope.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Background="#0E1217"
        Foreground="#E2E8F0"
        MinWidth="960" MinHeight="600"
        Width="1200" Height="780"
        WindowStartupLocation="CenterScreen"
        Title="MusicScope.NET - High Resolution Audio Analyzer">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- Top Toolbar & Header -->
        <Border Grid.Row="0" Background="#161B22" BorderBrush="#2D333B" BorderThickness="0,0,0,1" Padding="14,10">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="MusicScope" FontSize="18" FontWeight="Bold" Foreground="#00E5FF"/>
                    <Border Background="#21262D" CornerRadius="4" Padding="6,2">
                        <TextBlock Text=".NET 10" FontSize="11" Foreground="#8B949E" FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="24,0,0,0">
                    <Button Name="OpenFileBtn" Click="OnOpenFileClick" Background="#21262D" Foreground="#F0F6FC" Padding="12,6" CornerRadius="4">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="📁 Open Audio File"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding ToggleDawServerCommand}" Background="#21262D" Foreground="#F0F6FC" Padding="12,6" CornerRadius="4">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="🔌 DAW Server"/>
                        </StackPanel>
                    </Button>
                    <Button Name="ExportReportBtn" Click="OnExportReportClick" Background="#21262D" Foreground="#F0F6FC" Padding="12,6" CornerRadius="4">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="💾 Export Report"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Track info & DAW status -->
                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="20,0" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding TrackTitle}" FontWeight="SemiBold" FontSize="14" Foreground="#F0F6FC" TextAlignment="Center"/>
                    <TextBlock Text="{Binding FormatDetails}" FontSize="11" Foreground="#8B949E" TextAlignment="Center"/>
                </StackPanel>

                <!-- DAW status indicator badge -->
                <Border Grid.Column="3" Background="#1C2128" BorderBrush="#30363D" BorderThickness="1" CornerRadius="4" Padding="10,4" Margin="10,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding DawStatusText}" FontSize="11" Foreground="#58A6FF"/>
                </Border>
            </Grid>
        </Border>

        <!-- Main Body: Tabs -->
        <TabControl Grid.Row="1" Background="Transparent" Margin="6,4">
            <!-- TAB 1: Core Precision Analyzer -->
            <TabItem Header="Precision Analyzer" FontSize="13" FontWeight="SemiBold">
                <Grid RowDefinitions="*,Auto" Margin="4">
                    <Grid ColumnDefinitions="*,340,90" Margin="0,0,0,6">
                        <!-- Left: Frequency Spectrum -->
                        <Border Grid.Column="0" Background="#0F1216" BorderBrush="#22272E" BorderThickness="1" CornerRadius="6" Margin="0,0,6,0">
                            <Grid RowDefinitions="Auto,*">
                                <Border Background="#161B22" Padding="8,4" CornerRadius="6,6,0,0">
                                    <TextBlock Text="FREQUENCY SPECTRUM (FFT)" FontSize="11" FontWeight="Bold" Foreground="#8B949E"/>
                                </Border>
                                <ctrl:SpectrumGraphControl Grid.Row="1" MagnitudesDb="{Binding SpectrumMagnitudes}" SampleRate="{Binding SampleRate}"/>
                            </Grid>
                        </Border>

                        <!-- Middle: Goniometer & Circular Loudness Dials -->
                        <Grid Grid.Column="1" RowDefinitions="220,*" Margin="0,0,6,0">
                            <!-- Goniometer / Vector Scope -->
                            <Border Grid.Row="0" Background="#0F1216" BorderBrush="#22272E" BorderThickness="1" CornerRadius="6" Margin="0,0,0,6">
                                <Grid RowDefinitions="Auto,*">
                                    <Border Background="#161B22" Padding="8,4" CornerRadius="6,6,0,0">
                                        <TextBlock Text="STEREO GONIOMETER &amp; CORRELATION" FontSize="11" FontWeight="Bold" Foreground="#8B949E"/>
                                    </Border>
                                    <ctrl:GoniometerControl Grid.Row="1" Correlation="{Binding PhaseCorrelation}" PointsX="{Binding GoniometerPointsX}" PointsY="{Binding GoniometerPointsY}"/>
                                </Grid>
                            </Border>

                            <!-- Circular Loudness Dials -->
                            <Border Grid.Row="1" Background="#0F1216" BorderBrush="#22272E" BorderThickness="1" CornerRadius="6">
                                <Grid RowDefinitions="Auto,*">
                                    <Border Background="#161B22" Padding="8,4" CornerRadius="6,6,0,0">
                                        <TextBlock Text="LOUDNESS &amp; DYNAMICS (EBU R128)" FontSize="11" FontWeight="Bold" Foreground="#8B949E"/>
                                    </Border>
                                    <Grid Grid.Row="1" ColumnDefinitions="*,*">
                                        <ctrl:CircularDialControl Grid.Column="0" Value="{Binding IntegratedLoudness}" MinValue="-60" MaxValue="0" Label="INTEGRATED" Unit="LUFS"/>
                                        <ctrl:CircularDialControl Grid.Column="1" Value="{Binding LoudnessRange}" MinValue="0" MaxValue="30" Label="LRA" Unit="LU"/>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- Right: True Peak & Sample Peak LED Meters -->
                        <Border Grid.Column="2" Background="#0F1216" BorderBrush="#22272E" BorderThickness="1" CornerRadius="6">
                            <Grid RowDefinitions="Auto,*">
                                <Border Background="#161B22" Padding="6,4" CornerRadius="6,6,0,0">
                                    <TextBlock Text="METERS" FontSize="10" FontWeight="Bold" Foreground="#8B949E" TextAlignment="Center"/>
                                </Border>
                                <Grid Grid.Row="1" ColumnDefinitions="*,*" Margin="4">
                                    <ctrl:LevelMeterControl Grid.Column="0" ChannelName="L" PeakDb="{Binding SamplePeakLeft}" TruePeakDb="{Binding TruePeakLeft}" RmsDb="{Binding RmsLeft}"/>
                                    <ctrl:LevelMeterControl Grid.Column="1" ChannelName="R" PeakDb="{Binding SamplePeakRight}" TruePeakDb="{Binding TruePeakRight}" RmsDb="{Binding RmsRight}"/>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Bottom Metrics Cards -->
                    <Border Grid.Row="1" Background="#161B22" BorderBrush="#22272E" BorderThickness="1" CornerRadius="6" Padding="12,8">
                        <Grid ColumnDefinitions="*,*,*,*,*,*,*">
                            <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                <TextBlock Text="INTEGRATED" FontSize="9" Foreground="#8B949E" TextAlignment="Center"/>
                                <TextBlock Text="{Binding IntegratedLoudness, StringFormat='{}{0:F1} LUFS'}" FontSize="14" FontWeight="Bold" Foreground="#00E5FF" TextAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                <TextBlock Text="MAX MOMENTARY" FontSize="9" Foreground="#8B949E" TextAlignment="Center"/>
                                <TextBlock Text="{Binding MomentaryMax, StringFormat='{}{0:F1} LUFS'}" FontSize="14" FontWeight="Bold" Foreground="#58A6FF" TextAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                <TextBlock Text="MAX SHORT-TERM" FontSize="9" Foreground="#8B949E" TextAlignment="Center"/>
                                <TextBlock Text="{Binding ShortTermMax, StringFormat='{}{0:F1} LUFS'}" FontSize="14" FontWeight="Bold" Foreground="#58A6FF" TextAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                                <TextBlock Text="LOUDNESS RANGE" FontSize="9" Foreground="#8B949E" TextAlignment="Center"/>
                                <TextBlock Text="{Binding LoudnessRange, StringFormat='{}{0:F1} LU'}" FontSize="14" FontWeight="Bold" Foreground="#7EE787" TextAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4" HorizontalAlignment="Center">
                                <TextBlock Text="TRUE PEAK (MAX)" FontSize="9" Foreground="#8B949E" TextAlignment="Center"/>
                                <TextBlock Text="{Binding TruePeakLeft, StringFormat='{}{0:F2} dBTP'}" FontSize="14" FontWeight="Bold" Foreground="#FFA657" TextAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Grid.Column="5" HorizontalAlignment="Center">
                                <TextBlock Text="DYNAMIC RANGE" FontSize="9" Foreground="#8B949E" TextAlignment="Center"/>
                                <TextBlock Text="{Binding DynamicRange, StringFormat='{}DR{0:F0}'}" FontSize="14" FontWeight="Bold" Foreground="#D2A8FF" TextAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Grid.Column="6" HorizontalAlignment="Center">
                                <TextBlock Text="CORRELATION" FontSize="9" Foreground="#8B949E" TextAlignment="Center"/>
                                <TextBlock Text="{Binding PhaseCorrelation, StringFormat='{}{0:F3}'}" FontSize="14" FontWeight="Bold" Foreground="#7EE787" TextAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 2: THD Analyzer -->
            <TabItem Header="THD Analyzer" FontSize="13" FontWeight="SemiBold">
                <Border Background="#161B22" BorderBrush="#22272E" BorderThickness="1" CornerRadius="6" Margin="6" Padding="20">
                    <StackPanel Spacing="16" MaxWidth="600" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="Total Harmonic Distortion (THD) Measurement" FontSize="18" FontWeight="Bold" Foreground="#00E5FF"/>
                        <TextBlock Text="Analyzes 1 kHz sinusoidal test signals to evaluate harmonic distortions and SINAD of connected DACs, headphone amps, or soundcards." Foreground="#8B949E" TextWrapping="Wrap"/>
                        
                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" Margin="0,16">
                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="8">
                                <TextBlock Text="Total Harmonic Distortion (THD):" Foreground="#8B949E"/>
                                <TextBlock Text="{Binding ThdPercent, StringFormat='{}{0:F4} %'}" FontSize="24" FontWeight="Bold" Foreground="#7EE787"/>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="8">
                                <TextBlock Text="THD Attenuation:" Foreground="#8B949E"/>
                                <TextBlock Text="{Binding ThdAttenuationDb, StringFormat='{}{0:F1} dB'}" FontSize="24" FontWeight="Bold" Foreground="#58A6FF"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </TabItem>

            <!-- TAB 3: Turntable RPM -->
            <TabItem Header="Turntable RPM" FontSize="13" FontWeight="SemiBold">
                <Border Background="#161B22" BorderBrush="#22272E" BorderThickness="1" CornerRadius="6" Margin="6" Padding="20">
                    <StackPanel Spacing="16" MaxWidth="600" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="Turntable RPM &amp; Wow/Flutter Analyzer" FontSize="18" FontWeight="Bold" Foreground="#00E5FF"/>
                        <TextBlock Text="Evaluates rotation speed accuracy and wow/flutter using 1000 Hz or 3150 Hz reference vinyl test records." Foreground="#8B949E" TextWrapping="Wrap"/>

                        <Grid ColumnDefinitions="*,*,*" Margin="0,16">
                            <StackPanel Grid.Column="0" Margin="8">
                                <TextBlock Text="Measured Speed:" Foreground="#8B949E"/>
                                <TextBlock Text="{Binding TurntableRpm, StringFormat='{}{0:F3} RPM'}" FontSize="24" FontWeight="Bold" Foreground="#00E5FF"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="8">
                                <TextBlock Text="Deviation:" Foreground="#8B949E"/>
                                <TextBlock Text="{Binding RpmDeviation, StringFormat='{}{0:F2} %'}" FontSize="24" FontWeight="Bold" Foreground="#FFA657"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="8">
                                <TextBlock Text="Wow &amp; Flutter:" Foreground="#8B949E"/>
                                <TextBlock Text="{Binding WowAndFlutter, StringFormat='{}{0:F3} %'}" FontSize="24" FontWeight="Bold" Foreground="#7EE787"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </TabItem>

            <!-- TAB 4: Jitter Analyzer -->
            <TabItem Header="Jitter Analyzer" FontSize="13" FontWeight="SemiBold">
                <Border Background="#161B22" BorderBrush="#22272E" BorderThickness="1" CornerRadius="6" Margin="6" Padding="20">
                    <StackPanel Spacing="16" MaxWidth="600" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="Jitter Analyzer (Julian Dunn J-Test)" FontSize="18" FontWeight="Bold" Foreground="#00E5FF"/>
                        <TextBlock Text="Detects clock jitter and sideband modulation spurs around the 11.025 kHz stimulus tone." Foreground="#8B949E" TextWrapping="Wrap"/>

                        <StackPanel Margin="0,16">
                            <TextBlock Text="Detected Jitter (RMS):" Foreground="#8B949E"/>
                            <TextBlock Text="{Binding JitterPsRms, StringFormat='{}{0:F1} ps'}" FontSize="28" FontWeight="Bold" Foreground="#D2A8FF"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </TabItem>
        </TabControl>

        <!-- Bottom Status Bar -->
        <Border Grid.Row="2" Background="#161B22" BorderBrush="#2D333B" BorderThickness="0,1,0,0" Padding="12,4">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Text="{Binding FilePath, FallbackValue='Ready'}" FontSize="11" Foreground="#8B949E" VerticalAlignment="Center"/>
                <ProgressBar Grid.Column="1" Width="140" Height="6" Value="{Binding AnalysisProgress}" IsVisible="{Binding IsAnalyzing}" Margin="8,0,0,0"/>
            </Grid>
        </Border>
    </Grid>
</Window>
