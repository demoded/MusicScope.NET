<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MusicScope.Desktop.ViewModels"
        xmlns:ctrl="using:MusicScope.Desktop.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1180" d:DesignHeight="960"
        x:Class="MusicScope.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Background="#000000"
        Foreground="#E2E8F0"
        MinWidth="960" MinHeight="960"
        Width="1200" Height="980"
        WindowStartupLocation="CenterScreen"
        Title="MusicScope.NET - High Resolution Audio Analyzer">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*,Auto" Background="#000000">
        <!-- Top Toolbar & Header -->
        <Border Grid.Row="0" Background="#0A0D10" BorderBrush="#1C2127" BorderThickness="0,0,0,1" Padding="12,6">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="MusicScope" FontSize="16" FontWeight="Bold" Foreground="#00E5FF"/>
                    <Border Background="#161B22" CornerRadius="4" Padding="5,1">
                        <TextBlock Text=".NET 10" FontSize="10" Foreground="#8B949E" FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="16,0,0,0">
                    <Button Name="OpenFileBtn" Click="OnOpenFileClick" Background="#161B22" Foreground="#F0F6FC" Padding="10,5" CornerRadius="4">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="📁 Open Audio File" FontSize="12"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding ToggleDawServerCommand}" Background="#161B22" Foreground="#F0F6FC" Padding="10,5" CornerRadius="4">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="🔌 DAW Server" FontSize="12"/>
                        </StackPanel>
                    </Button>
                    <Button Name="ExportReportBtn" Click="OnExportReportClick" Background="#161B22" Foreground="#F0F6FC" Padding="10,5" CornerRadius="4">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="💾 Export Report" FontSize="12"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Track info & DAW status -->
                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="16,0" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding TrackTitle}" FontWeight="SemiBold" FontSize="13" Foreground="#F0F6FC" TextAlignment="Center"/>
                    <TextBlock Text="{Binding FormatDetails}" FontSize="10" Foreground="#8B949E" TextAlignment="Center"/>
                </StackPanel>

                <!-- DAW status indicator badge -->
                <Border Grid.Column="3" Background="#11161D" BorderBrush="#252B33" BorderThickness="1" CornerRadius="4" Padding="8,3" Margin="8,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding DawStatusText}" FontSize="10" Foreground="#58A6FF"/>
                </Border>
            </Grid>
        </Border>

        <!-- Main Body: Tabs -->
        <TabControl Grid.Row="1" Background="#000000" Padding="0" Margin="0">
            <!-- TAB 1: Authentic MusicScope Analyzer -->
            <TabItem Header="MusicScope" FontSize="12" FontWeight="SemiBold">
                <Grid RowDefinitions="360,*,320" Background="#000000">
                    <!-- Row 0: Top 5 Boxes -->
                    <Grid Grid.Row="0" ColumnDefinitions="1.1*,1.1*,1.1*,2.0*,1.5*" Background="#000000">
                        <!-- Box 1: Format Matrix -->
                        <Border Grid.Column="0" BorderBrush="#1C2127" BorderThickness="0,0,1,1" Background="#000000">
                            <ctrl:FormatBoxControl FormatName="{Binding FormatName}"
                                                   SampleRate="{Binding SampleRate}"
                                                   BitDepth="{Binding BitDepth}"
                                                   IsDsd="{Binding IsDsd}"/>
                        </Border>

                        <!-- Box 2: Levels & Bit Monitor -->
                        <Border Grid.Column="1" BorderBrush="#1C2127" BorderThickness="0,0,1,1" Background="#000000">
                            <ctrl:LevelsBoxControl TruePeakLeft="{Binding TruePeakLeft}"
                                                   TruePeakRight="{Binding TruePeakRight}"
                                                   RmsLeft="{Binding RmsLeft}"
                                                   RmsRight="{Binding RmsRight}"
                                                   CrestFactor="{Binding CrestFactor}"
                                                   Plr="{Binding Plr}"
                                                   MomentaryCurrent="{Binding MomentaryCurrent}"
                                                   MomentaryMax="{Binding MomentaryMax}"
                                                   ShortTermCurrent="{Binding ShortTermCurrent}"
                                                   ShortTermMax="{Binding ShortTermMax}"
                                                   IntegratedLoudness="{Binding IntegratedLoudness}"
                                                   LoudnessRange="{Binding LoudnessRange}"/>
                        </Border>

                        <!-- Box 3: S-Mode Loudness & LED Peak Meter -->
                        <Border Grid.Column="2" BorderBrush="#1C2127" BorderThickness="0,0,1,1" Background="#000000">
                            <ctrl:SModeMeterControl PeakLeftDb="{Binding InstantPeakLeft}"
                                                    PeakRightDb="{Binding InstantPeakRight}"
                                                    MaxPeakLeftDb="{Binding TruePeakLeft}"
                                                    MaxPeakRightDb="{Binding TruePeakRight}"
                                                    RmsLeftDb="{Binding InstantRmsLeft}"
                                                    RmsRightDb="{Binding InstantRmsRight}"
                                                    MomentaryLufs="{Binding MomentaryCurrent}"
                                                    MomentaryMaxLufs="{Binding MomentaryMax}"
                                                    ShortTermLufs="{Binding ShortTermCurrent}"
                                                    ShortTermMaxLufs="{Binding ShortTermMax}"
                                                    IntegratedLufs="{Binding IntegratedLoudness}"
                                                    PlrDb="{Binding InstantPlr}"
                                                    MidLevelDb="{Binding MidLevel}"
                                                    SideLevelDb="{Binding SideLevel}"
                                                    LoudnessRange="{Binding LoudnessRange}"
                                                    LraLow="{Binding LraLow}"
                                                    LraHigh="{Binding LraHigh}"
                                                    SModeHistogram="{Binding SModeHistogram}"
                                                    SModeMaxCount="{Binding SModeMaxCount}"/>
                        </Border>

                        <!-- Box 4: Circular Polar History Radar Dial -->
                        <Border Grid.Column="3" BorderBrush="#1C2127" BorderThickness="0,0,1,1" Background="#000000">
                            <ctrl:HistoryDialControl PeakHistory="{Binding PeakHistory}"
                                                     LoudnessHistory="{Binding LoudnessHistory}"
                                                     TrackProgress="{Binding TrackProgress}"/>
                        </Border>

                        <!-- Box 5: Stereo Goniometer / Vector Scope & Correlation Bar -->
                        <Border Grid.Column="4" BorderBrush="#1C2127" BorderThickness="0,0,0,1" Background="#000000">
                            <ctrl:GoniometerControl Correlation="{Binding PhaseCorrelation}"
                                                    PointsX="{Binding GoniometerPointsX}"
                                                    PointsY="{Binding GoniometerPointsY}"
                                                    DensityCloud="{Binding StereoDensityCloud}"
                                                    TrackProgress="{Binding TrackProgress}"/>
                        </Border>
                    </Grid>

                    <!-- Row 1: Linear Frequency Spectrum [kHz] -->
                    <Border Grid.Row="1" BorderBrush="#1C2127" BorderThickness="0,0,0,1" Background="#000000">
                        <ctrl:SpectrumGraphControl MagnitudesDb="{Binding SpectrumMagnitudes}"
                                                   InstantMagnitudesDb="{Binding InstantSpectrumMagnitudes}"
                                                   SampleRate="{Binding SampleRate}"/>
                    </Border>

                    <!-- Row 2: 2D Waterfall / Spectrogram Heatmap -->
                    <Border Grid.Row="2" Background="#000000">
                        <ctrl:WaterfallControl LatestSpectrum="{Binding InstantSpectrumMagnitudes}"
                                               SpectrogramMax="{Binding SpectrogramMax}"
                                               SpectrogramAvg="{Binding SpectrogramAvg}"
                                               SpectrogramMin="{Binding SpectrogramMin}"
                                               SpectrogramRowCount="{Binding SpectrogramRowCount}"
                                               TrackProgress="{Binding TrackProgress}"
                                               SampleRate="{Binding SampleRate}"/>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 2: THD Analyzer -->
            <TabItem Header="THD Analyzer" FontSize="13" FontWeight="SemiBold">
                <Border Background="#161B22" BorderBrush="#22272E" BorderThickness="1" CornerRadius="6" Margin="6" Padding="20">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="16" MaxWidth="720" HorizontalAlignment="Center">
                            <TextBlock Text="Total Harmonic Distortion (THD) Measurement" FontSize="18" FontWeight="Bold" Foreground="#00E5FF"/>
                            
                            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" Margin="0,4">
                                <Border Grid.Row="0" Grid.Column="0" Background="#0D1117" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6" Padding="14" Margin="4">
                                    <StackPanel>
                                        <TextBlock Text="Total Harmonic Distortion (THD):" Foreground="#8B949E" FontSize="12"/>
                                        <TextBlock Text="{Binding ThdPercent, StringFormat='{}{0:F4} %'}" FontSize="24" FontWeight="Bold" Foreground="#7EE787" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Row="0" Grid.Column="1" Background="#0D1117" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6" Padding="14" Margin="4">
                                    <StackPanel>
                                        <TextBlock Text="THD Attenuation:" Foreground="#8B949E" FontSize="12"/>
                                        <TextBlock Text="{Binding ThdAttenuationDb, StringFormat='{}{0:F1} dB'}" FontSize="24" FontWeight="Bold" Foreground="#58A6FF" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Informational Text from MusicScope StreamSettingsDialog -->
                            <Border Background="#0D1117" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6" Padding="16">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="The Total Harmonic Distortion (THD) Analyzer uses a 1 kHz test signal to measure harmonic distortions of HiFi components which have an adverse effect on the music reproduction."
                                               Foreground="#C9D1D9" TextWrapping="Wrap" LineHeight="20"/>

                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="Download Test Signal:" Foreground="#8B949E" VerticalAlignment="Center" FontSize="12"/>
                                        <Button Content="16Bit WAV" Command="{Binding OpenUrlCommand}" CommandParameter="https://www.xivero.com/downloads/1kHz-44100Hz-16Bit-Sinus.wav"
                                                Padding="10,4" Background="#21262D" Foreground="#58A6FF" BorderBrush="#30363D" BorderThickness="1" CornerRadius="4" Cursor="Hand" FontSize="11"/>
                                        <Button Content="24Bit WAV" Command="{Binding OpenUrlCommand}" CommandParameter="https://www.xivero.com/downloads/1kHz-44100Hz-24Bit-Sinus.wav"
                                                Padding="10,4" Background="#21262D" Foreground="#58A6FF" BorderBrush="#30363D" BorderThickness="1" CornerRadius="4" Cursor="Hand" FontSize="11"/>
                                    </StackPanel>

                                    <TextBlock Text="To execute the measurement it is necessary to use an analog to digital converter (ADC). This can be either an external device connected via USB or the laptop or desktop line-input."
                                               Foreground="#C9D1D9" TextWrapping="Wrap" LineHeight="20"/>

                                    <Border Background="#261C00" BorderBrush="#9E6A03" BorderThickness="1" CornerRadius="4" Padding="10,6">
                                        <TextBlock Text="Attention: The microphone input does not work!" Foreground="#E3B341" FontWeight="SemiBold"/>
                                    </Border>

                                    <TextBlock Text="Measurement:" FontWeight="Bold" Foreground="#E6EDF3" Margin="0,4,0,0"/>

                                    <StackPanel Spacing="6" Margin="6,0,0,0">
                                        <TextBlock Text="1. Connect the output of the HiFi component with the ADC input (Attention: Be aware of maximum allowed levels!)."
                                                   Foreground="#8B949E" TextWrapping="Wrap"/>
                                        <TextBlock Text="2. Launch the THD Analyzer and select the audio input. A click on &quot;Start&quot; initiates the measurement."
                                                   Foreground="#8B949E" TextWrapping="Wrap"/>
                                        <TextBlock Text="3. Inject the 1 kHz test signal into the component via computer, CD-Player, etc."
                                                   Foreground="#8B949E" TextWrapping="Wrap"/>
                                        <TextBlock Text="4. The level of the measured test signal should be below 0 dB."
                                                   Foreground="#8B949E" TextWrapping="Wrap"/>
                                    </StackPanel>

                                    <TextBlock Text="All harmonic distortions above a threshold are marked with their frequency [Hz], amplitude [dB] and THD [%]."
                                               Foreground="#8B949E" TextWrapping="Wrap" Margin="0,4,0,0"/>

                                    <TextBlock Text="The overall THD is provided in percent and as a relative measurement to the test signal in dB."
                                               Foreground="#8B949E" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </TabItem>

            <!-- TAB 3: Turntable RPM -->
            <TabItem Header="Turntable RPM" FontSize="13" FontWeight="SemiBold">
                <Border Background="#161B22" BorderBrush="#22272E" BorderThickness="1" CornerRadius="6" Margin="6" Padding="20">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="16" MaxWidth="720" HorizontalAlignment="Center">
                            <TextBlock Text="Turntable RPM &amp; Wow/Flutter Analyzer" FontSize="18" FontWeight="Bold" Foreground="#00E5FF"/>

                            <Grid ColumnDefinitions="*,*,*" Margin="0,4">
                                <Border Grid.Column="0" Background="#0D1117" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6" Padding="14" Margin="4">
                                    <StackPanel>
                                        <TextBlock Text="Measured Speed:" Foreground="#8B949E" FontSize="12"/>
                                        <TextBlock Text="{Binding TurntableRpm, StringFormat='{}{0:F3} RPM'}" FontSize="24" FontWeight="Bold" Foreground="#00E5FF" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Background="#0D1117" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6" Padding="14" Margin="4">
                                    <StackPanel>
                                        <TextBlock Text="Deviation:" Foreground="#8B949E" FontSize="12"/>
                                        <TextBlock Text="{Binding RpmDeviation, StringFormat='{}{0:F2} %'}" FontSize="24" FontWeight="Bold" Foreground="#FFA657" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Background="#0D1117" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6" Padding="14" Margin="4">
                                    <StackPanel>
                                        <TextBlock Text="Wow &amp; Flutter:" Foreground="#8B949E" FontSize="12"/>
                                        <TextBlock Text="{Binding WowAndFlutter, StringFormat='{}{0:F3} %'}" FontSize="24" FontWeight="Bold" Foreground="#7EE787" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Informational Text from MusicScope StreamSettingsDialog -->
                            <Border Background="#0D1117" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6" Padding="16">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="The &quot;Turntable RPM Measurement&quot; module enables the measurement of the turntable rounds per minute with a precision of 0.01 %."
                                               Foreground="#C9D1D9" TextWrapping="Wrap" LineHeight="20"/>

                                    <TextBlock Text="We only need a Signal to Noise Ratio (SNR) of 9 dB and a test duration of 15 – 20 seconds to achieve a very precise measurement."
                                               Foreground="#C9D1D9" TextWrapping="Wrap" LineHeight="20"/>

                                    <TextBlock Text="Measurement:" FontWeight="Bold" Foreground="#E6EDF3" Margin="0,4,0,0"/>

                                    <StackPanel Spacing="6" Margin="6,0,0,0">
                                        <TextBlock Text="1. Use of a test LP that provides a frequency stable test sinus with an arbitrary frequency within the range of 400 Hz – 5000 Hz."
                                                   Foreground="#8B949E" TextWrapping="Wrap"/>
                                        <TextBlock Text="2. Set the nominal RPM (33 1/3 or 45)."
                                                   Foreground="#8B949E" TextWrapping="Wrap"/>
                                        <TextBlock Text="3. Provide the test frequency played by the record (e.g. 1000 Hz)."
                                                   Foreground="#8B949E" TextWrapping="Wrap"/>
                                        <TextBlock Text="4. The test signal can be recorded either by microphone (e.g. Laptop Microphone) or via phono pre-amp (Line-In). Select the audio input source via the &quot;Input&quot; drop-down menu. The input signal level must be above -20 dB. A correct level is indicated by a green marked level meter."
                                                   Foreground="#8B949E" TextWrapping="Wrap"/>
                                        <TextBlock Text="5. Playback of the test track and starting of the &quot;Turntable RPM Measurement&quot; module."
                                                   Foreground="#8B949E" TextWrapping="Wrap"/>
                                    </StackPanel>

                                    <TextBlock Text="All deviations above 1% are marked red and they are not part of the averaging to get the measured data. Numerous deviations beyond the 1% mark are an indication for a turntable problem."
                                               Foreground="#8B949E" TextWrapping="Wrap" Margin="0,4,0,0"/>

                                    <TextBlock Text="If there is no signal then the measurement stops. Furthermore, the tool stops after 120 seconds of continuous measurement automatically."
                                               Foreground="#8B949E" TextWrapping="Wrap"/>

                                    <TextBlock Text="Positive deviations are marked orange whereas negative deviations are marked blue to make the interpretation of the deviation plot as easy as possible."
                                               Foreground="#8B949E" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </TabItem>

            <!-- TAB 4: Jitter Analyzer -->
            <TabItem Header="Jitter Analyzer" FontSize="13" FontWeight="SemiBold">
                <Border Background="#161B22" BorderBrush="#22272E" BorderThickness="1" CornerRadius="6" Margin="6" Padding="20">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="16" MaxWidth="720" HorizontalAlignment="Center">
                            <TextBlock Text="Jitter Analyzer (Julian Dunn J-Test)" FontSize="18" FontWeight="Bold" Foreground="#00E5FF"/>

                            <Border Background="#0D1117" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6" Padding="14" Margin="4">
                                <StackPanel>
                                    <TextBlock Text="Detected Jitter (RMS):" Foreground="#8B949E" FontSize="12"/>
                                    <TextBlock Text="{Binding JitterPsRms, StringFormat='{}{0:F1} ps'}" FontSize="28" FontWeight="Bold" Foreground="#D2A8FF" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Informational Text from MusicScope StreamSettingsDialog -->
                            <Border Background="#0D1117" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6" Padding="16">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="The Jitter Analyzer uses an 11.025 kHz test signal to measure the periodical jitter of a digital to analog converter (DAC). Especially periodical jitter causes harmonic distortions which have an adverse effect on the music reproduction."
                                               Foreground="#C9D1D9" TextWrapping="Wrap" LineHeight="20"/>

                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="Download Test Signal:" Foreground="#8B949E" VerticalAlignment="Center" FontSize="12"/>
                                        <Button Content="11.025 kHz 16Bit WAV" Command="{Binding OpenUrlCommand}" CommandParameter="https://www.xivero.com/downloads/JitterTest-11025Hz-44100Hz-16Bit.wav"
                                                Padding="10,4" Background="#21262D" Foreground="#58A6FF" BorderBrush="#30363D" BorderThickness="1" CornerRadius="4" Cursor="Hand" FontSize="11"/>
                                    </StackPanel>

                                    <TextBlock Text="To execute the measurement it is necessary to use an analog to digital converter (ADC). This can be either an external device connected via USB or the laptop or desktop line-input."
                                               Foreground="#C9D1D9" TextWrapping="Wrap" LineHeight="20"/>

                                    <Border Background="#261C00" BorderBrush="#9E6A03" BorderThickness="1" CornerRadius="4" Padding="10,6">
                                        <TextBlock Text="Attention: The microphone input does not work!" Foreground="#E3B341" FontWeight="SemiBold"/>
                                    </Border>

                                    <TextBlock Text="Measurement:" FontWeight="Bold" Foreground="#E6EDF3" Margin="0,4,0,0"/>

                                    <StackPanel Spacing="6" Margin="6,0,0,0">
                                        <TextBlock Text="1. Connect the DAC output with the ADC input."
                                                   Foreground="#8B949E" TextWrapping="Wrap"/>
                                        <TextBlock Text="2. Launch the Jitter Analyzer and select the audio input. A click on &quot;Start&quot; initiates the measurement."
                                                   Foreground="#8B949E" TextWrapping="Wrap"/>
                                        <TextBlock Text="3. Inject the 11.025 kHz test signal via computer, CD-Player, etc."
                                                   Foreground="#8B949E" TextWrapping="Wrap"/>
                                        <TextBlock Text="4. The level of the test signal should be just below 0 dBFS."
                                                   Foreground="#8B949E" TextWrapping="Wrap"/>
                                        <TextBlock Text="5. Measurement of the side bands by using the mouse pointer. The jitter is directly displayed in pico seconds (ps)."
                                                   Foreground="#8B949E" TextWrapping="Wrap"/>
                                    </StackPanel>

                                    <TextBlock Text="The displayed spectrum bandwidth can be switched between &quot;Narrow&quot; for a detailed jitter search around the test signal to &quot;Medium&quot;, &quot;Wide&quot; or &quot;Ultra Wide&quot; to identify jitter with higher frequencies."
                                               Foreground="#8B949E" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </TabItem>
        </TabControl>

        <!-- Bottom Status Bar -->
        <Border Grid.Row="2" Background="#0A0D10" BorderBrush="#1C2127" BorderThickness="0,1,0,0" Padding="12,4">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Text="{Binding FilePath, FallbackValue='Ready'}" FontSize="11" Foreground="#8B949E" VerticalAlignment="Center"/>
                <ProgressBar Grid.Column="1" Width="140" Height="6" Value="{Binding AnalysisProgress}" IsVisible="{Binding IsAnalyzing}" Margin="8,0,0,0"/>
            </Grid>
        </Border>
    </Grid>
</Window>
