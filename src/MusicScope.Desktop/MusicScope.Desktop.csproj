<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/MusicScope.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="Models\" />
    <InternalsVisibleTo Include="MusicScope.Desktop.Tests" />
    <AvaloniaResource Include="Assets\**" />
    <None Update="Assets/MusicScope*.png" CopyToPublishDirectory="PreserveNewest" />
    <None Update="Packaging/Linux/MusicScope.NET.desktop" Link="MusicScope.NET.desktop"
          CopyToPublishDirectory="PreserveNewest" Condition="$([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('linux-'))" />
    <None Update="Packaging/Linux/install-desktop-entry.sh" Link="install-desktop-entry.sh"
          CopyToPublishDirectory="PreserveNewest" Condition="$([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('linux-'))" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.3" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.3" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MusicScope.Core\MusicScope.Core.csproj" />
    <ProjectReference Include="..\MusicScope.Audio\MusicScope.Audio.csproj" />
    <ProjectReference Include="..\MusicScope.Network\MusicScope.Network.csproj" />
    <ProjectReference Include="..\MusicScope.Reporting\MusicScope.Reporting.csproj" />
  </ItemGroup>
</Project>
